# Sauna monitoring instance (.env)
# Copy to .env and fill every required value before starting.
# docker compose up -d

MONITORING_PROJECT=sauna

# Required secrets (startup fails if empty)
CLICKHOUSE_COLLECTOR_PASSWORD=
CLICKHOUSE_GRAFANA_PASSWORD=
GRAFANA_ADMIN_USER=admin
# Used only when the grafana-data volume is first created. Rotate an existing
# password with: docker compose exec grafana grafana cli admin reset-admin-password '<new password>'
GRAFANA_ADMIN_PASSWORD=
# Scrapes Grafana /metrics with basic auth. Keep this different from the admin password.
GRAFANA_METRICS_PASSWORD=

# Host identity reported in telemetry
HOST_NAME=

# Host bind addresses and ports. Defaults are loopback-only and avoid clashing
# with factory monitoring (3000/4317/4318). LAN access is plain HTTP unless fronted by TLS.
GRAFANA_BIND_ADDR=127.0.0.1
OTLP_BIND_ADDR=127.0.0.1
GRAFANA_PORT=3001
OTLP_GRPC_PORT=4327
OTLP_HTTP_PORT=4328
# Full browser-reachable Grafana URL, including trailing slash and any sub-path.
GRAFANA_ROOT_URL=http://127.0.0.1:3001/

# Retention / tuning
TRACES_TTL_DAYS=7
LOGS_TTL_DAYS=14
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB
CLICKHOUSE_MAX_SERVER_MEMORY_BYTES=805306368
CLICKHOUSE_MEMORY_LIMIT=768m
OTEL_COLLECTOR_MEMORY_LIMIT=192m
PROMETHEUS_MEMORY_LIMIT=256m
GRAFANA_MEMORY_LIMIT=256m

# Alert defaults (override per project; regenerate rules if you change them)
ALERT_CONTACT_POINT_URL=http://127.0.0.1:1/product-monitoring-alert
ALERT_BACKEND_SILENT_MINUTES=10
ALERT_HIGH_ERROR_RATE_PERCENT=2
ALERT_HIGH_ERROR_RATE_MIN_REQUESTS=20
ALERT_HIGH_LATENCY_SECONDS=1
ALERT_PROJECTION_LAG_THRESHOLD=100
ALERT_NOTIFICATION_PENDING_THRESHOLD=50
ALERT_NOTIFICATION_PENDING_MINUTES=30
ALERT_SIDECAR_ERROR_RATE_PERCENT=5
ALERT_TELEMETRY_DROPPED_MINUTES=10
ALERT_DISK_USAGE_PERCENT=85
