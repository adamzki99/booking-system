# Sauna deployment environment variables.
# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- Runtime / networking ---
PORT=8080

# --- Database (PostgreSQL) ---
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=booking
DATABASE_URL=postgres://booking:change-me@postgres:5432/booking

# --- Sidecar ---
SIDECAR_URL=http://sidecar:8081

# --- Email (backend) ---
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Public / self-hosting (Cloudflare Tunnel) ---
PUBLIC_BASE_URL=https://booking.example.com
CLOUDFLARE_TUNNEL_TOKEN=