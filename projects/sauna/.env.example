# Sauna deployment environment variables.
# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- Runtime / networking ---
PORT=8080

# --- Database (PostgreSQL) ---
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=booking
DATABASE_URL=postgres://booking:change-me@postgres:5432/booking

# --- Sidecar ---
SIDECAR_URL=http://sidecar:8081
BOOKING_TIMEZONE=Europe/Stockholm
SAUNA_CAPACITY=1
# QA/dev only: comma-separated daily redeploy times (HH:MM, BOOKING_TIMEZONE)
# shown as a countdown in the header. Leave empty in production.
REDEPLOY_TIMES=

# --- Email (backend) ---
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Public / self-hosting (Cloudflare Tunnel) ---
PUBLIC_BASE_URL=https://booking.example.com
CLOUDFLARE_TUNNEL_TOKEN=

# --- Let's Encrypt TLS (HTTPS for dev/QA and prod) ---
# Public FQDN whose certificate Caddy obtains and auto-renews. Each environment
# must set a distinct value (e.g. qa.booking.example.com vs booking.example.com)
# so prod and dev/QA get separate certificate instances. Leave empty for local
# runs: Caddy serves an internal self-signed certificate for "localhost".
SITE_ADDRESS=
# Contact email for the Let's Encrypt ACME account (expiry/abuse notices).
# Caddy uses a placeholder (admin@localhost) when empty.
ACME_EMAIL=
# ACME directory URL. Defaults to Let's Encrypt production. Point at the
# Let's Encrypt staging CA for testing to avoid rate limits:
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=

# --- Telemetry (OpenTelemetry -> SigNoz) ---
# OTLP/HTTP collector endpoint (SigNoz listens on 4318). The persistent SigNoz
# stack lives in dev-ops/signoz/ (independent of booking-* compose projects).
# For Docker-on-host deployments, host.docker.internal reaches the host-published
# collector; use http://<signoz-host>:4318 when the collector is elsewhere.
# Leave empty to disable export (backend logs a warning).
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_SERVICE_NAME=booking-backend

# --- Dev-server operator SSH (local operator use only; not container config) ---
# Keep real values in the gitignored .env. Key authentication is preferred;
# port defaults to 22 and user defaults to the current local user when empty.
DEV_SERVER_HOST=
DEV_SERVER_PORT=
DEV_SERVER_USER=
DEV_SERVER_KEY=
DEV_SERVER_KEY_PATH=
DEV_SERVER_PASSWORD=
DEV_SERVER_KNOWN_HOSTS=
DEV_SERVER_ALLOWED_COMMANDS=
DEV_SERVER_LOG_FILE=
DEV_SERVER_ACTOR=
