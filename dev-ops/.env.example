# Dev-server operator environment. Copy to dev-ops/.env (gitignored), fill in
# locally, then export with: set -a; . dev-ops/.env; set +a
# Never commit real hosts, user names, keys, passwords, or known-hosts data.

# Required SSH target. Port defaults to 22 and user defaults to the current user.
DEV_SERVER_HOST=
DEV_SERVER_PORT=
DEV_SERVER_USER=

# Key-based authentication is preferred. KEY_PATH is an alias for KEY. If both
# are empty, ~/.ssh/id_ed25519 and ~/.ssh/id_rsa are tried in that order.
DEV_SERVER_KEY=
DEV_SERVER_KEY_PATH=

# Optional password authentication. Requires sshpass and an interactive y/N
# confirmation. Never put the password on a command line.
DEV_SERVER_PASSWORD=

# Optional known-hosts file. OpenSSH's standard files are used when empty;
# StrictHostKeyChecking=yes is always enabled.
DEV_SERVER_KNOWN_HOSTS=

# Optional newline-separated exact command allow-list. This restricts commands;
# it never pre-approves mutations or bypasses the interactive approval gate.
DEV_SERVER_ALLOWED_COMMANDS=

# Optional local JSONL audit log and actor override. Defaults:
# ${XDG_STATE_HOME:-~/.local/state}/booking-system/dev-server-agent.jsonl
# and the current local user.
DEV_SERVER_LOG_FILE=
DEV_SERVER_ACTOR=
