{
  "$schema": "../../product/frontend-solid/node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-debugger": "error",
    "eqeqeq": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "promise/always-return": "off",
    "promise/catch-or-return": "off",
    "promise/no-callback-in-promise": "off",
    "unicorn/consistent-function-scoping": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/no-disabled-tests": "warn",
    "vitest/no-focused-tests": "error",
    "vitest/expect-expect": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": ["Input", "Select", "Textarea"],
        "depth": 3
      }
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/package-lock.json",
    ".opencode/skills/**",
    ".opencode/commands/**",
    ".opencode/agents/**",
    "projects/sauna/docs/mocks/**",
    "dev-ops/docs/booking-system-repo-reports/**",
    "dev-ops/factory/monitoring/grafana/dashboards/*.json",
    "product/monitoring/grafana/dashboards/*.json",
    "product/monitoring/grafana/provisioning/alerting/*.yaml",
    "**/*.go",
    "**/*.py"
  ]
}
