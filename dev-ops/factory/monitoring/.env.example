# Factory monitoring stack (.env)
# Copy to .env and fill every required secret before starting.
# docker compose up -d

# Required secrets (startup fails if empty)
CLICKHOUSE_COLLECTOR_PASSWORD=
CLICKHOUSE_GRAFANA_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Host identity reported in telemetry (OBS-12: avoid container hostname)
HOST_NAME=

# Host ports, bound to 127.0.0.1 only
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Host paths
# Factory JSONL log directory (read-only bind mount for collector filelog)
FACTORY_LOG_DIR=${XDG_STATE_HOME:-~/.local/state}/factory
# Factory Prometheus textfile metrics directory (read-only bind mount for node-exporter)
FACTORY_METRICS_DIR=${XDG_STATE_HOME:-~/.local/state}/factory/metrics

# Alert contact points (optional). Alerts still evaluate in Grafana if unset.
# E-mail requires Grafana SMTP settings below and ALERT_EMAIL_TO.
ALERT_EMAIL_TO=
# Webhook works with ntfy, Slack, Discord, or any HTTP endpoint.
ALERT_WEBHOOK_URL=

# Grafana SMTP (optional, required for e-mail alerts)
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
GF_SMTP_FROM_NAME=Factory Monitoring

# Retention / tuning
CLICKHOUSE_MAX_SERVER_MEMORY_BYTES=805306368
CLICKHOUSE_TTL_DAYS=400
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
FACTORY_SESSION_TIMEOUT=3600

# Langfuse profile (docker compose --profile langfuse up -d)
# Required when enabling the langfuse profile. Startup check fails if empty.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY= # openssl rand -hex 32
LANGFUSE_POSTGRES_PASSWORD=
# Keep the existing volume for v3. During the PostgreSQL 18 migration, point
# this at a new volume restored from the verified v3 dump; see README.md.
LANGFUSE_POSTGRES_VOLUME=factory-monitoring_langfuse-postgres-data
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_ROOT_USER=langfuse
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
# v3 to v4 migration defaults retain legacy behavior. Change only through the
# staged upgrade procedure in README.md.
LANGFUSE_MIGRATION_V4_WRITE_MODE=legacy
LANGFUSE_MIGRATION_V4_NATIVE_OTEL_BEHAVIOUR=dual_write
LANGFUSE_MIGRATION_V4_ALLOW_PREVIEW_OPT_IN=false
LANGFUSE_BACKGROUND_MIGRATION_V4_ENABLE_HISTORIC_BACKFILL=false
# Collector fan-out to Langfuse OTLP (set when langfuse profile is enabled).
# Basic auth header: base64(public_key:secret_key)
LANGFUSE_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel
LANGFUSE_OTLP_AUTH_HEADER=
# Initial Langfuse bootstrap (optional but recommended for reproducible setup)
LANGFUSE_INIT_ORG_ID=factory-org
LANGFUSE_INIT_ORG_NAME=Factory
LANGFUSE_INIT_PROJECT_ID=factory-project
LANGFUSE_INIT_PROJECT_NAME=Factory
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=Factory Admin
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_PORT=3001
