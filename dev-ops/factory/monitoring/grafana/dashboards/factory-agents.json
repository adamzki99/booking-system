      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-factory"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "factory",
              "limit": 1000,
              "mode": "list",
              "queryType": "table"
            }
          },
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT\n  r.agent_id,\n  r.agent_version,\n  r.model,\n  uniqExactIf(p.pr_number, p.merged_at IS NOT NULL) AS merged_prs,\n  round(sum(coalesce(r.duration_ms,0))/3600000,3) AS run_hours,\n  round(uniqExactIf(p.pr_number, p.merged_at IS NOT NULL) / nullIf(sum(coalesce(r.duration_ms,0))/3600000,0),3) AS merged_prs_per_run_hour\nFROM factory.runs r\nLEFT JOIN factory.pr_outcomes p ON p.issue_id = r.issue_id AND p.repo = r.repo\nWHERE $__timeFilter(r.started_at) AND ('*' IN (${r.factory_id:singlequote}) OR r.factory_id IN (${r.factory_id:singlequote}))\n  AND ('*' IN (${r.agent_id:singlequote}) OR r.agent_id IN (${r.agent_id:singlequote}))\n  AND ('*' IN (${r.model:singlequote}) OR r.model IN (${r.model:singlequote}))\n  AND ('*' IN (${r.kind:singlequote}) OR r.kind IN (${r.kind:singlequote}))\nGROUP BY r.agent_id, r.agent_version, r.model\nORDER BY merged_prs_per_run_hour DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Leaderboard (merged PRs per run hour)",
      "type": "table"
    },
