          "rawSql": "SELECT round(sumIf(coalesce(cost_usd,toDecimal64(0,6)), outcome='completed') / nullIf(uniqExactIf(issue_id, outcome='completed' AND issue_id IS NOT NULL),0), 4) AS value\nFROM factory.runs WHERE $__timeFilter(started_at) AND ('*' IN (${factory_id:singlequote}) OR factory_id IN (${factory_id:singlequote}))\n  AND ('*' IN (${agent_id:singlequote}) OR agent_id IN (${agent_id:singlequote}))\n  AND ('*' IN (${model:singlequote}) OR model IN (${model:singlequote}))\n  AND ('*' IN (${kind:singlequote}) OR kind IN (${kind:singlequote}))",
