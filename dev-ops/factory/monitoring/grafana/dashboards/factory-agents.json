      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-factory"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "factory",
              "limit": 1000,
              "mode": "list",
              "queryType": "table"
            }
          },
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT\n  agent_id,\n  agent_version,\n  model,\n  count() AS runs,\n  countIf(outcome='completed') AS successes,\n  round(countIf(outcome='completed')*100.0/nullIf(count(),0),1) AS success_rate_pct,\n  round(avgIf(duration_ms, outcome IN ('completed','failed'))/1000,1) AS avg_duration_s,\n  round(sumIf(coalesce(cost_usd,toDecimal64(0,6)), outcome='completed')/nullIf(uniqExactIf(issue_id,outcome='completed' AND issue_id IS NOT NULL),0),4) AS avg_cost_per_success_issue_usd,\n  round(countIf(fallback_level IN ('backup','free'))*100.0/nullIf(count(),0),1) AS backup_free_pct,\n  uniqExactIf(pr_number, outcome='completed' AND pr_number IS NOT NULL) AS prs_touched\nFROM factory.runs\nWHERE $__timeFilter(started_at) AND ('*' IN (${factory_id:singlequote}) OR factory_id IN (${factory_id:singlequote}))\n  AND ('*' IN (${agent_id:singlequote}) OR agent_id IN (${agent_id:singlequote}))\n  AND ('*' IN (${model:singlequote}) OR model IN (${model:singlequote}))\n  AND ('*' IN (${kind:singlequote}) OR kind IN (${kind:singlequote}))\nGROUP BY agent_id, agent_version, model\nORDER BY successes DESC, runs DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Agent / version / model performance",
      "type": "table"
    },
