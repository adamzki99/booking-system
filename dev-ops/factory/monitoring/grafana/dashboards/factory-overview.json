      "pluginVersion": "10.4.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-factory"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "factory",
              "limit": 1000,
              "mode": "list",
              "queryType": "table"
            }
          },
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT avg(dateDiff('second', r.first_run_at, p.merged_at)) AS value\nFROM (\n  SELECT issue_id, min(started_at) AS first_run_at\n  FROM factory.runs\n  WHERE $__timeFilter(started_at) AND issue_id IS NOT NULL AND ('*' IN (${factory_id:singlequote}) OR factory_id IN (${factory_id:singlequote}))\n  AND ('*' IN (${agent_id:singlequote}) OR agent_id IN (${agent_id:singlequote}))\n  AND ('*' IN (${model:singlequote}) OR model IN (${model:singlequote}))\n  AND ('*' IN (${kind:singlequote}) OR kind IN (${kind:singlequote}))\n  GROUP BY issue_id\n) r\nINNER JOIN (\n  SELECT issue_id, max(ts) AS merged_at\n  FROM factory.events FINAL\n  WHERE event='pr.merged' AND issue_id IS NOT NULL\n  GROUP BY issue_id\n) p ON p.issue_id = r.issue_id\nWHERE p.merged_at > r.first_run_at",
          "refId": "A"
        }
      ],
      "title": "Avg pickup to merge",
      "type": "stat"
    },
