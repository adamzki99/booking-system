    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-factory"
      },
      "description": "Trace waterfall from otel.otel_traces for the selected run trace_id. Requires Grafana ClickHouse datasource traces support.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 3,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-factory"
          },
          "editorType": "sql",
          "format": 3,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "otel",
              "limit": 1000,
              "mode": "list",
              "queryType": "traces"
            }
          },
          "pluginVersion": "4.23.5",
          "queryType": "traces",
          "rawSql": "SELECT\n  TraceId AS traceID,\n  SpanId AS spanID,\n  ParentSpanId AS parentSpanID,\n  ServiceName AS serviceName,\n  SpanName AS operationName,\n  Timestamp AS startTime,\n  Duration / 1000000 AS duration,\n  arrayMap(k -> map('key', k, 'value', SpanAttributes[k]), mapKeys(SpanAttributes)) AS tags,\n  arrayMap(k -> map('key', k, 'value', ResourceAttributes[k]), mapKeys(ResourceAttributes)) AS serviceTags,\n  if(StatusCode = 'STATUS_CODE_ERROR' OR StatusCode = 'Error' OR StatusCode = '2', 2, 0) AS statusCode\nFROM otel.otel_traces\nWHERE TraceId = ${trace_id:singlequote}\nORDER BY Timestamp ASC\nLIMIT 1000",
          "refId": "A"
        }
      ],
      "title": "Trace (waterfall)",
      "type": "traces"
    },
