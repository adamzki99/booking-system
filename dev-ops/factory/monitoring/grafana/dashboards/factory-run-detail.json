      "pluginVersion": "10.4.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-factory"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "factory",
              "limit": 1000,
              "mode": "list",
              "queryType": "table"
            }
          },
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT\n  Timestamp AS ts,\n  SpanName AS span,\n  SpanAttributes['gen_ai.request.model'] AS model,\n  toInt64OrNull(SpanAttributes['gen_ai.usage.input_tokens']) AS input_tokens,\n  toInt64OrNull(SpanAttributes['gen_ai.usage.output_tokens']) AS output_tokens,\n  toInt64OrNull(SpanAttributes['gen_ai.usage.reasoning_tokens']) AS reasoning_tokens,\n  toInt64OrNull(SpanAttributes['gen_ai.usage.cache_read_tokens']) AS cache_read_tokens,\n  toInt64OrNull(SpanAttributes['gen_ai.usage.cache_write_tokens']) AS cache_write_tokens,\n  toFloat64OrNull(SpanAttributes['gen_ai.usage.cost_usd']) AS cost_usd,\n  Duration / 1000000 AS duration_ms\nFROM otel.otel_traces\nWHERE TraceId = ${trace_id:singlequote}\n  AND SpanName IN ('opencode.llm.step', 'factory.agent.run')\nORDER BY Timestamp ASC\nLIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Tokens per step",
      "type": "table"
    }
