      "pluginVersion": "10.4.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-factory"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "factory",
              "limit": 1000,
              "mode": "list",
              "queryType": "table"
            }
          },
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT\n  run_id, factory_id, tick_id, kind, agent_id, agent_version, prompt_version, model, tier_label,\n  fallback_level, attempt, issue_id, pr_number, repo, session_id, trace_id,\n  started_at, ended_at, outcome, failure_reason, duration_ms,\n  input_tokens, output_tokens, reasoning_tokens, cache_read_tokens, cache_write_tokens,\n  cost_usd, tool_calls, tool_errors, files_changed, exit_code, error_fingerprint\nFROM factory.runs\nWHERE run_id = ${run_id:singlequote}\nLIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Run summary",
      "type": "table"
    },
