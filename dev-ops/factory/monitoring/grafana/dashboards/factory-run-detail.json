      "pluginVersion": "10.4.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-factory"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "factory",
              "limit": 1000,
              "mode": "list",
              "queryType": "table"
            }
          },
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT ts, event, status, kind, agent_id, model, session_id, trace_id, duration_ms, failure_reason, error_fingerprint, attrs\nFROM factory.events FINAL\nWHERE run_id = ${run_id:singlequote}\nORDER BY ts ASC\nLIMIT 500",
          "refId": "A"
        }
      ],
      "title": "Run events",
      "type": "table"
