      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-factory"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "factory",
              "limit": 1000,
              "mode": "list",
              "queryType": "table"
            }
          },
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT round(sum(coalesce(cost_usd,toDecimal64(0,6))) / nullIf(uniqExactIf(pr_number, event='pr.merged' AND pr_number IS NOT NULL),0),4) AS value\nFROM (\n  SELECT ts, pr_number, event, factory_id, toDecimal64(0,6) AS cost_usd FROM factory.events FINAL WHERE $__timeFilter(ts) AND event='pr.merged'\n  UNION ALL\n  SELECT started_at AS ts, pr_number, outcome AS event, factory_id, coalesce(cost_usd,toDecimal64(0,6)) AS cost_usd FROM factory.runs WHERE $__timeFilter(started_at)\n) t WHERE ('*' IN (${factory_id:singlequote}) OR factory_id IN (${factory_id:singlequote}))",
          "refId": "A"
        }
      ],
      "title": "Cost / merged PR",
      "type": "stat"
    },
