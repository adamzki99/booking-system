      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-factory"
          },
          "editorType": "sql",
          "format": 1,
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "factory",
              "limit": 1000,
              "mode": "list",
              "queryType": "table"
            }
          },
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT database, table, formatReadableSize(sum(bytes_on_disk)) AS size, sum(rows) AS rows\nFROM system.parts\nWHERE active AND database IN ('factory', 'otel')\nGROUP BY database, table\nORDER BY sum(bytes_on_disk) DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "ClickHouse disk use by table",
      "type": "table"
