          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT Timestamp, ServiceName, SpanName, round(Duration/1000000,2) AS DurationMs, StatusCode, TraceId\nFROM otel.otel_traces\nWHERE Timestamp >= now() - INTERVAL 1 HOUR\nORDER BY Timestamp DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Trace search (ClickHouse)",
      "type": "table"
    },
    {
      "datasource": {
