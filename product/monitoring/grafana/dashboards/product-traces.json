  "panels": [
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-product"
      },
      "description": "Log volume by severity from ClickHouse.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-product"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT toStartOfFiveMinutes(Timestamp) AS time, SeverityText, count() AS logs\nFROM otel.otel_logs\nWHERE Timestamp >= now() - INTERVAL 1 HOUR\nGROUP BY time, SeverityText\nORDER BY time ASC\nLIMIT 1000",
          "refId": "A"
        }
      ],
      "title": "Log volume by level (ClickHouse, 1h)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-product"
      },
      "description": "Recent error traces. Open TraceId in Explore for details.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-product"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.23.5",
          "queryType": "table",
          "rawSql": "SELECT Timestamp, ServiceName, SpanName, round(Duration/1000000,2) AS DurationMs, StatusMessage, TraceId\nFROM otel.otel_traces\nWHERE Timestamp >= now() - INTERVAL 6 HOUR\n  AND StatusCode = 'STATUS_CODE_ERROR'\nORDER BY Timestamp DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Recent error traces (ClickHouse)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
