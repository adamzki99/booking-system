    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-product"
      },
      "description": "Event append rate by event type.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "sum by (type) (rate(events_appended_total{deployment_environment=~\"$deployment_environment\",service_name=~\"$service_name\",service_version=~\"$service_version\"}[5m]))",
          "legendFormat": "{{type}}",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Events appended by type",
      "type": "timeseries"
