          "editorMode": "code",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{deployment_environment=~\"$deployment_environment\",service_name=~\"$service_name\",service_version=~\"$service_version\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{deployment_environment=~\"$deployment_environment\",service_name=~\"$service_name\",service_version=~\"$service_version\"}[5m])), 1e-9)) * 100",
