{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-product"
        },
        "enable": true,
        "expr": "changes(process_start_time_seconds{deployment_environment=~\"$deployment_environment\",service_name=~\"$service_name\"}[5m]) > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Deploy / restart markers",
        "titleFormat": "restart {{service_name}} {{service_version}}"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-product"
      },
      "description": "Go runtime memory metrics when runtime instrumentation is enabled.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (go_memory_used_bytes{deployment_environment=~\"$deployment_environment\",service_name=~\"$service_name\",go_memory_type=\"heap\"})",
          "legendFormat": "{{service_name}} heap",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (process_runtime_go_mem_heap_alloc_bytes{deployment_environment=~\"$deployment_environment\",service_name=~\"$service_name\"})",
          "legendFormat": "{{service_name}} alloc",
          "instant": false,
          "range": true,
          "refId": "B",
          "format": "time_series"
        }
      ],
      "title": "Go heap / memory",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-product"
      },
      "description": "Go runtime goroutines and GC rate.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (go_goroutine_count{deployment_environment=~\"$deployment_environment\",service_name=~\"$service_name\"})",
          "legendFormat": "{{service_name}} goroutines",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (rate(process_runtime_go_gc_count_total{deployment_environment=~\"$deployment_environment\",service_name=~\"$service_name\"}[5m]))",
          "legendFormat": "{{service_name}} gc/s",
          "instant": false,
          "range": true,
          "refId": "B",
          "format": "time_series"
        }
      ],
      "title": "Goroutines / GC",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-product"
      },
      "description": "Container memory if cAdvisor/docker metrics are present. May show No data when not scraped.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\".+\"})",
          "legendFormat": "{{name}}",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Container memory (if available)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-product"
      },
      "description": "Host memory from node-exporter profile. Shows No data when host profile is disabled.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "used",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "available",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Host memory (node exporter profile)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-product"
      },
      "description": "Postgres metrics when postgres profile is enabled. Shows No data when profile/exporter is not configured.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "pg_up",
          "legendFormat": "pg_up",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "sum(rate(pg_stat_database_xact_commit[5m]))",
          "legendFormat": "commits/s",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Postgres exporter (profile)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-product"
      },
      "description": "Caddy metrics when Caddy metrics are scraped. Shows No data when caddy scrape/profile is not configured.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "sum(rate(caddy_http_requests_total[5m])) by (server)",
          "legendFormat": "{{server}}",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-product"
          },
          "editorMode": "code",
          "expr": "sum(rate(caddy_http_request_errors_total[5m])) by (server)",
          "legendFormat": "errors {{server}}",
          "instant": false,
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Caddy metrics (profile)",
      "type": "timeseries"
    }
  ],
