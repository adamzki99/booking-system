# Product monitoring stack (.env)
# Copy to .env and fill every required value before starting.
# docker compose up -d

# Required. Used for compose project name (<project>-monitoring), network
# (<project>-monitoring-net), Grafana instance name, and default project label.
MONITORING_PROJECT=

# Required secrets (startup fails if empty)
CLICKHOUSE_COLLECTOR_PASSWORD=
CLICKHOUSE_GRAFANA_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Host identity reported in telemetry
HOST_NAME=

# Host ports, bound to 127.0.0.1 only. Pick ports that do not clash with other
# stacks on the same host.
GRAFANA_PORT=
OTLP_GRPC_PORT=
OTLP_HTTP_PORT=

# Retention / tuning
TRACES_TTL_DAYS=7
LOGS_TTL_DAYS=14
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB
CLICKHOUSE_MAX_SERVER_MEMORY_BYTES=805306368

# Optional memory limits
CLICKHOUSE_MEMORY_LIMIT=768m
OTEL_COLLECTOR_MEMORY_LIMIT=192m
PROMETHEUS_MEMORY_LIMIT=256m
GRAFANA_MEMORY_LIMIT=256m

# Optional postgres profile (read-only monitoring user; create it manually)
# POSTGRES_EXPORTER_DSN=postgres:5432/booking?sslmode=disable
# POSTGRES_EXPORTER_USER=monitoring_readonly
# POSTGRES_EXPORTER_PASSWORD=
