    "@solidjs/vite-plugin": "3.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/node": "^22.10.1",
    "eslint-plugin-solid": "^0.20.1",
    "eslint-plugin-testing-library": "7.16.3",
    "jsdom": "^31.0.1",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
